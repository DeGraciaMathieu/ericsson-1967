{
    "name": "ericsson/1967",
    "description": "POC d'architecture à blocs et signaux (exécutif, files, adressage nommé)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Ericsson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ericsson\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
